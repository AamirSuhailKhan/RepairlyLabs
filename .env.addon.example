# Append to existing .env. Never commit real credentials.
# Razorpay: start with test credentials, create distinct webhook secret.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Signed HTTPS webhook to your trusted automation service (optional). Sends full booking details.
RL_NOTIFY_URL=
RL_NOTIFY_SECRET=
# Owner email via Resend (optional; verify sender domain).
RL_RESEND_KEY=
RL_FROM_EMAIL=
RL_OWNER_EMAIL=
# Owner WhatsApp notification (optional; approved business template with 3 body parameters: event, reference, device).
RL_WA_TOKEN=
RL_WA_PHONE_ID=
RL_WA_OWNER=
RL_WA_TEMPLATE=
RL_WA_LANGUAGE=en
RL_WA_GRAPH_VERSION=

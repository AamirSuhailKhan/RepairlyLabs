# Copy to .env, update before public launch
PORT=3001
NODE_ENV=development
# Dedicated persistent volume location (absolute path is fine)
DATA_DIR=./data
# Optional, only used by npm run setup. Do not commit actual credentials.
# ADMIN_USERNAME=owner
# ADMIN_PASSWORD=change-to-a-unique-strong-8-plus-character-password
# Optional: only behind a trusted local reverse proxy
# TRUST_PROXY=1
# Optional signed automation alerts (Make / n8n / Zapier / custom endpoint)
# NOTIFY_WEBHOOK_URL=https://your-provider.example/unique-endpoint
# NOTIFY_WEBHOOK_SECRET=replace-with-a-long-random-shared-secret

# Repair Center Add-on Configuration (Optional / Sandbox)
# Razorpay payment gateway
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=
# Automation webhook (Make / Zapier / n8n)
# RL_NOTIFY_URL=
# RL_NOTIFY_SECRET=
# Owner email alerts via Resend
# RL_RESEND_KEY=
# RL_FROM_EMAIL=
# RL_OWNER_EMAIL=
# Owner WhatsApp alerts via Meta Cloud API
# RL_WA_TOKEN=
# RL_WA_PHONE_ID=
# RL_WA_OWNER=
# RL_WA_TEMPLATE=
# RL_WA_LANGUAGE=en
# RL_WA_GRAPH_VERSION=
# Required for public deployment and verified-email recovery; use actual HTTPS origin only.
# PUBLIC_ORIGIN=https://your-real-domain.example
# Email recovery uses RL_RESEND_KEY and RL_FROM_EMAIL above; verify sender domain with provider.

# V1.3 optional provider integration. Never commit real values.
RL_GATEWAY_QR_ENABLED=0
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
RL_WA_CUSTOMER_TEMPLATE=
RL_WA_CUSTOMER_LANGUAGE=en
# 32 bytes random hex; keep stable and securely backed up
RL_MFA_KEY=

# Optional privacy-preserving HTTP status/timing logs
RL_REQUEST_LOG=0

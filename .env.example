# Copy to .env, update before public launch
PORT=3001
NODE_ENV=development
# Dedicated persistent volume location (absolute path is fine)
DATA_DIR=./data
# Optional, only used by npm run setup. Do not commit actual credentials.
# ADMIN_USERNAME=owner
# ADMIN_PASSWORD=change-to-a-unique-strong-12-plus-character-password
# Optional: only behind a trusted local reverse proxy
# TRUST_PROXY=1
# Optional signed automation alerts (Make / n8n / Zapier / custom endpoint)
# NOTIFY_WEBHOOK_URL=https://your-provider.example/unique-endpoint
# NOTIFY_WEBHOOK_SECRET=replace-with-a-long-random-shared-secret

{
  "name": "repairlylabs",
  "version": "1.3.1",
  "private": true,
  "type": "module",
  "description": "Dependency-free full-stack mobile repair and spare parts repair enquiries and India-wide part quote platform",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "start": "node src/server.mjs",
    "dev": "node --watch src/server.mjs",
    "setup": "node scripts/setup.mjs",
    "backup": "node scripts/backup.mjs",
    "test": "node --test tests/*.test.mjs",
    "audit": "node tests/audit_suite.mjs",
    "restore:check": "node scripts/restore-check.mjs"
  }
}
